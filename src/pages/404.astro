---
import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="404 · Página no encontrada"
  description="La página que buscas no existe."
  noindex
>
  <main id="contenido" class="flex flex-col items-center justify-center flex-1 px-4 py-32 text-center">
    <p class="text-8xl font-black font-dot text-accent dark:text-accent-light sm:text-9xl">404</p>
    <p class="mt-6 font-mono text-sm tracking-wider text-gray-600 uppercase dark:text-gray-400">
      Página no encontrada
    </p>
    <p class="mt-3 font-mono text-xs text-gray-500 dark:text-gray-400">
      ¿Probamos con <code class="text-accent dark:text-accent-light">git checkout main</code>?
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center gap-2 px-5 py-1.5 mt-8 text-white transition rounded-full bg-accent hover:bg-red-800 active:bg-red-900 motion-safe:hover:-translate-y-0.5 motion-safe:active:translate-y-0 focus:outline-none focus-visible:ring focus-visible:ring-accent/80 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950"
    >
      Volver al inicio
    </a>
  </main>
</Layout>
