---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import LinkButton from "@/components/LinkButton.astro"
import GitHub from "@/components/icons/GitHub.astro"
import ExternalLink from "@/components/icons/ExternalLink.astro"
import { getTag } from "@/components/projectTags"
import projectsData from "@/data/projects.json"
import caseStudiesData from "@/data/case-studies.json"

interface Project {
  slug?: string
  shortTitle?: string
  title: string
  description: string
  category: string
  tags: string[]
  image?: string
  link?: string
  github?: string
}

interface CaseStudy {
  slug: string
  example?: boolean
  role: string
  problem: string
  decisions: { title: string; description: string }[]
  ai: string
  verification: string
  limits: string[]
  next: string[]
}

// getStaticPaths is hoisted, so it can only use imports, not the constants above
export function getStaticPaths() {
  return (projectsData as Project[])
    .filter((project) => project.slug)
    .map((project) => ({
      params: { slug: project.slug },
      props: {
        project,
        study: (caseStudiesData as CaseStudy[]).find((item) => item.slug === project.slug),
      },
    }))
}

const { project, study } = Astro.props as { project: Project; study?: CaseStudy }
const tags = project.tags.map(getTag)
const heading = project.shortTitle ?? project.title
const subtitle = project.shortTitle
  ? project.title.replace(new RegExp(`^${project.shortTitle}\\s*[-–:]\\s*`), "")
  : undefined
---

<Layout
  title={`${heading} · Proyecto · Alan McLure`}
  description={project.description}
>
  <main class="px-4">
    <SectionContainer class="py-32 md:py-40">
      <a
        href="/#proyectos"
        class="font-mono text-xs tracking-wider text-gray-600 uppercase dark:text-gray-400 hover:text-accent dark:hover:text-accent-light"
      >
        ← Proyectos
      </a>

      <p class="mt-8 font-mono text-xs tracking-wider text-accent dark:text-accent-light uppercase">
        {project.category}
      </p>
      <h1 class="mt-2 text-5xl font-black text-gray-800 font-dot sm:text-6xl dark:text-white">
        {heading}
      </h1>
      {subtitle && (
        <p class="mt-3 text-xl text-gray-700 dark:text-gray-300">{subtitle}</p>
      )}

      <ul class="flex flex-wrap gap-2 mt-5">
        {tags.map((tag) => (
          <li>
            <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
              {tag.icon && <tag.icon class="size-4" />}
              {tag.name}
            </span>
          </li>
        ))}
      </ul>

      <p class="max-w-2xl mt-6 text-lg text-gray-800 dark:text-gray-200 text-pretty">
        {project.description}
      </p>

      <div class="flex flex-wrap gap-4 mt-6">
        {project.github && (
          <LinkButton href={project.github}>
            <GitHub class="size-5" />
            Code
          </LinkButton>
        )}
        {project.link && (
          <LinkButton href={project.link}>
            <ExternalLink class="size-4" />
            Preview
          </LinkButton>
        )}
      </div>

      {project.image && (
        <div class="mt-12 overflow-hidden border rounded-2xl border-black/15 dark:border-white/15">
          <img
            src={project.image}
            alt={project.title}
            class="object-cover object-top w-full"
          />
        </div>
      )}

      {study && (
        <div class="mt-16">
          {study.example && (
            <p class="px-4 py-3 mb-10 font-mono text-xs border rounded-xl border-accent/50 text-accent dark:text-accent-light">
              Contenido de ejemplo: los textos son ilustrativos y no están validados.
            </p>
          )}

          <p class="text-sm text-gray-600 dark:text-gray-400">
            <span class="font-mono tracking-wider uppercase">Rol</span> · {study.role}
          </p>

          <div class="mt-10 space-y-14">
            <section>
              <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">01 · EL PROBLEMA</h2>
              <p class="text-lg text-gray-800 dark:text-gray-200 text-pretty">{study.problem}</p>
            </section>

            <section>
              <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">02 · DECISIONES TÉCNICAS</h2>
              <ul class="grid gap-4 sm:grid-cols-2">
                {study.decisions.map((decision) => (
                  <li class="p-6 border rounded-2xl border-black/15 dark:border-white/15">
                    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">{decision.title}</h3>
                    <p class="mt-2 text-gray-700 dark:text-gray-400 text-pretty">{decision.description}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section>
              <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">03 · CÓMO USÉ LA IA</h2>
              <p class="text-gray-800 dark:text-gray-200 text-pretty">{study.ai}</p>
            </section>

            <section>
              <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">04 · VERIFICACIÓN</h2>
              <p class="text-gray-800 dark:text-gray-200 text-pretty">{study.verification}</p>
            </section>

            <section class="grid gap-10 sm:grid-cols-2">
              <div>
                <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">05 · LIMITACIONES</h2>
                <ul class="pl-5 space-y-2 text-gray-800 list-disc dark:text-gray-200 marker:text-accent">
                  {study.limits.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h2 class="mb-4 font-mono text-xs tracking-wider text-accent dark:text-accent-light">06 · QUÉ MEJORARÍA</h2>
                <ul class="pl-5 space-y-2 text-gray-800 list-disc dark:text-gray-200 marker:text-accent">
                  {study.next.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </section>
          </div>
        </div>
      )}
    </SectionContainer>
  </main>
</Layout>
