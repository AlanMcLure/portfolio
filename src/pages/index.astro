---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import AIWorkflow from "@/components/AIWorkflow.astro"
import Sparkles from "@/components/icons/Sparkles.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeDots from "@/components/icons/CodeDots.astro"
import education from "@/data/education.json"
import Contact from "@/components/Contact.astro"
import Experience from "@/components/Experience.astro"
import MailIcon from "@/components/icons/Mail.astro"
import School from "@/components/icons/School.astro"
import UserHeart from "@/components/icons/UserHeart.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
---

<Layout
  title="Alan McLure · Software Developer en Valencia"
  description="Software Developer en Valencia con más de 2 años de experiencia. Desarrollo de software, aplicaciones móviles y automatizaciones con IA."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-8" />
        Experiencia
      </TitleSection>
      <Experience />
    </SectionContainer>

    <SectionContainer id="formacion">
      <TitleSection>
        <School class="size-8" />
        Formación
      </TitleSection>
      <Experience items={education} label="Formación académica" />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeDots class="size-7" />
        Proyectos
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="ia">
      <TitleSection>
        <Sparkles class="size-8" />
        Cómo trabajo con IA
      </TitleSection>
      <AIWorkflow />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <TitleSection>
        <UserHeart class="size-8" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <SectionContainer id="contacto">
      <TitleSection>
        <MailIcon class="size-8" />
        Contacto
      </TitleSection>
      <Contact />
    </SectionContainer>
  </div>
  </main>
</Layout>
