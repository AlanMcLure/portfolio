---
const { className } = Astro.props
---

<div class="mb-8">
  <h2
    class={`flex items-center font-dot text-4xl font-bold gap-x-3 text-black/80 dark:text-white ${className ?? ""}`}
  >
    <slot />
  </h2>
  <!-- Accent underline -->
  <div
    class="mt-3 h-0.5 w-10 bg-accent dark:bg-accent-light"
    aria-hidden="true"
  >
  </div>
</div>
