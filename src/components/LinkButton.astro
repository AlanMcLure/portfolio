---
const { href, target = "_blank" } = Astro.props;
---

<a
    target={target}
    href={href}
    class="inline-flex bg-gray-100 text-gray-800 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-gray-800 border dark:border-gray-600 text-md hover:bg-accent hover:border-accent hover:text-white active:bg-red-800 active:border-red-800 motion-safe:hover:-translate-y-0.5 motion-safe:active:translate-y-0 group max-w-fit rounded-xl focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-accent/80 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950"
>
    <slot />
</a>
