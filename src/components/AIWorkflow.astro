---
import steps from "@/data/ia-workflow.json"
---

<p class="max-w-xl mb-10 text-gray-700 dark:text-gray-300 text-pretty">
  La IA acelera, pero el criterio es mío. Este es el método que sigo con cualquier proyecto, sea cual sea el stack.
</p>

<ol class="grid gap-4 sm:grid-cols-2" aria-label="Cómo trabajo con IA">
  {
    steps.map(({ title, description }, i) => (
      <li class="p-6 border rounded-2xl border-black/15 dark:border-white/15">
        <span class="font-mono text-xs tracking-wider text-accent dark:text-accent-light">
          {String(i + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-2 text-xl font-bold text-gray-800 dark:text-gray-100">{title}</h3>
        <p class="mt-2 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
      </li>
    ))
  }
</ol>
