---
const personalImageAlt = "Alan McLure Alarcón"
import Badge from "@/components/Badge.astro"
import DownloadIcon from "@/components/icons/Download.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_300px]">
<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <div class="relative flex-shrink-0 lg:hidden">
      <img
        class="relative object-cover rounded-full size-20 ring-1 ring-black/25 dark:ring-white/25"
        src="/foto-perfil-min.webp"
        width="80"
        height="80"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/alanmclurealarcon"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 font-dot text-5xl font-bold text-gray-800 sm:text-6xl dark:text-white"
  >
    Hey, soy Alan
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-gray-800 dark:text-gray-300"
  >
  <span>+2 años de experiencia.</span>
  <span class="font-mono text-base">Software Developer</span>.
  De Valencia, España. Especializado en
  <span class="font-mono text-base text-accent dark:text-accent-light">Angular</span> y
  <span class="font-mono text-base text-accent dark:text-accent-light">SpringBoot</span>.
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Redes sociales y contacto"
  >
    <SocialPill href="mailto:amclurealarcon@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/alanmclurealarcon">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/AlanMcLure">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill href="/cv-alan-mclure.pdf" download="cv-alan-mclure.pdf">
      <DownloadIcon class="size-4" />
      CV
    </SocialPill>
  </nav>
</div>

  <figure class="hidden lg:block anim-fade-in anim-delay-2">
    <div
      class="relative overflow-hidden aspect-square rounded-3xl ring-1 ring-black/15 dark:ring-white/20 bg-neutral-200 dark:bg-neutral-900"
    >
      <img
        class="object-cover size-full"
        src="/foto-perfil.webp"
        width="800"
        height="1041"
        loading="lazy"
        alt={personalImageAlt}
      />
      <figcaption
        class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-4 font-mono text-xs tracking-wider text-white uppercase bg-gradient-to-t from-black/70 to-transparent"
      >
        <span class="rounded-full size-1.5 bg-accent-light" aria-hidden="true"></span>
        Valencia, ES
      </figcaption>
    </div>
  </figure>
</div>
