---
import ExperienceItem from "./ExperienceItem.astro"
import experience from "@/data/experience.json"

interface Entry {
  date: string
  title: string
  company: string
  description: string
  link?: string
  linkLabel?: string
  current?: boolean
}

interface Props {
  items?: Entry[]
  label?: string
}

const { items = experience, label = "Experiencia laboral" } = Astro.props
---

<ol class="relative mt-16" aria-label={label}>
  {
    items.map((exp, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <ExperienceItem {...exp} />
      </li>
    ))
  }
</ol>
