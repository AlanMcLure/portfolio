---
import GitHub from "./icons/GitHub.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"
import { getTag } from "./projectTags"
import LinkInline from "./LinkInline.astro"
import ArrowRight from "./icons/ArrowRight.astro"

interface Project {
  slug?: string
  shortTitle?: string
  title: string
  description: string
  category: string
  tags: string[]
  image?: string
  link?: string
  github?: string
  pendingLink?: boolean
}

const projects: Project[] = projectsData

const PROJECTS = projects.map((project) => ({
  ...project,
  tags: project.tags.map(getTag),
}))

const categories = [...new Set(PROJECTS.map((project) => project.category))]
const pad = (n: number) => String(n).padStart(2, "0")
---

{
  categories.length > 1 && (
    <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filtrar proyectos por categoría">
      {["Todos", ...categories].map((category, i) => (
        <button
          type="button"
          data-filter={i === 0 ? "all" : category}
          aria-pressed={i === 0 ? "true" : "false"}
          class="px-3 py-1 font-mono text-xs tracking-wider uppercase transition border rounded-full border-black/20 dark:border-white/25 text-gray-800 dark:text-white/80 hover:border-accent aria-pressed:bg-accent aria-pressed:border-accent aria-pressed:text-white"
        >
          {category}
        </button>
      ))}
    </div>
  )
}

<div class="grid gap-16 md:grid-cols-2 md:gap-x-10">
  {
    PROJECTS.map(({ slug, image, title, description, category, tags, link, github, pendingLink }, i) => (
      <article
        data-project
        data-category={category}
        class:list={[
          "flex flex-col gap-6 group [&[hidden]]:hidden",
          i === 0 && "md:col-span-2 md:flex-row md:gap-10",
        ]}
      >
        <a
          href={slug ? `/proyectos/${slug}` : undefined}
          aria-label={slug ? `Ver el proyecto ${title}` : undefined}
          class:list={["block w-full", i === 0 && "md:w-1/2"]}
        >
          <div class="relative flex flex-col items-center overflow-clip rounded-2xl border border-black/15 dark:border-white/15 transition-all duration-500 ease-in-out md:group-hover:-translate-y-1 md:group-hover:border-accent/50 md:group-hover:shadow-[0_20px_60px_-10px_rgba(215,25,33,0.2)]">
            {image ? (
              <img
                alt={title}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            ) : (
              <div
                class="grid w-full h-56 font-dot text-7xl font-black text-black/25 dark:text-white/25 place-items-center bg-[radial-gradient(rgba(0,0,0,0.15)_1px,transparent_1px)] dark:bg-[radial-gradient(rgba(255,255,255,0.15)_1px,transparent_1px)] [background-size:16px_16px]"
                aria-hidden="true"
              >
                {title.charAt(0)}
              </div>
            )}
          </div>
        </a>

        <div class:list={["flex flex-col justify-center w-full", i === 0 && "md:w-1/2 md:max-w-lg"]}>
          <span class="mb-2 font-mono text-xs tracking-wider text-accent dark:text-accent-light uppercase">
            {pad(i + 1)} / {pad(PROJECTS.length)} · {category}
          </span>
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {slug ? <a href={`/proyectos/${slug}`} class="hover:underline underline-offset-4">{title}</a> : title}
          </h3>
          <ul class="flex flex-row flex-wrap gap-2 mt-3">
            {tags.map((tag) => (
              <li>
                <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
                  {tag.icon && <tag.icon class="size-4" />}
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
          <footer class="flex flex-wrap items-center mt-4 gap-4">
            {slug && (
              <LinkInline href={`/proyectos/${slug}`}>
                Ver proyecto <ArrowRight class="size-5" aria-hidden="true" />
              </LinkInline>
            )}
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-5" />
                Code
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <ExternalLink class="size-4" />
                Preview
              </LinkButton>
            )}
            {pendingLink && (
              <span class="font-mono text-xs tracking-wider text-accent dark:text-accent-light">[PENDING] Enlace</span>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]")
    const projects = document.querySelectorAll<HTMLElement>("[data-project]")

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)))
        projects.forEach((project) => {
          project.hidden = filter !== "all" && project.dataset.category !== filter
        })
      })
    })
  })
</script>
